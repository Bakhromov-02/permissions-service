# Gateway tokens (at least 16 characters, must differ). Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token-0000
SERVICE_TOKEN=change-me-service-token-000

POSTGRES_PASSWORD=postgres

# Only needed when running the services outside Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/permissions
# NATS_URL=nats://localhost:4222
# CACHE_TTL_SECONDS=300
# NATS_REQUEST_TIMEOUT_MS=2000
# PORT=3000

# Observability (docker compose): fraction of requests traced, 1.0 = all. Use 0.01 for load tests.
TRACE_SAMPLE_RATIO=1.0
# false = always read PostgreSQL (to measure what the cache buys)
CACHE_ENABLED=true
