      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, status) (rate(gateway_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
