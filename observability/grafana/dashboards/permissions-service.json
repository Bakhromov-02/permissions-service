    {
      "id": 9,
      "type": "timeseries",
      "title": "NATS round trip by outcome (p95)",
      "description": "Gateway → permissions service request–reply latency, split by outcome (ok, no_responders, timeout, …)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
